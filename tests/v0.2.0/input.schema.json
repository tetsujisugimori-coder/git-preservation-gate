        "enum": [
          "BLOCKED",
          "FAIL",
          "NOT_TESTED",
          "PARTIAL",
          "PASS",
          "UNKNOWN"
        ]
      },
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_]+$"
      }
    },
    "contract_extra_required": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_]+$"
      }
    },
    "risk_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "rationale",
        "approval",
        "risks"
      ],
      "properties": {
        "decision": {
          "enum": [
            "required",
            "not_required",
            "UNKNOWN"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "approval": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN",
            "NOT_TESTED"
          ]
        },
        "risks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "confidential",
              "irrecoverable",
              "destructive",
              "strong_authenticity"
            ]
          }
        }
      }
